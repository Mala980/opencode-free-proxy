{
  "name": "opencode-free-proxy",
  "version": "1.1.0",
  "description": "Free OpenCode Zen models exposed as OpenAI, Responses and Anthropic APIs",
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "opencode-free-proxy": "server.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "oxlint .",
    "doctor": "node scripts/doctor.mjs",
    "compare:zen": "node scripts/doctor.mjs --compare-paths",
    "update:models": "node scripts/update-models.mjs",
    "capture:fixture": "node scripts/capture-cli-fixture.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "server.mjs",
    "lib/",
    "models.json",
    "scripts/",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "impers": "0.1.2"
  },
  "optionalDependencies": {
    "@searchcast/libcurl-darwin-arm64": "0.1.0",
    "@searchcast/libcurl-darwin-x64": "0.1.0",
    "@searchcast/libcurl-linux-arm64": "0.1.0",
    "@searchcast/libcurl-linux-x64": "0.1.0",
    "@searchcast/libcurl-win32-x64": "0.1.0"
  },
  "devDependencies": {
    "oxlint": "^1.86.0"
  }
}
